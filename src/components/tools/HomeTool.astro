---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.home;
const common = translations[lang].common;
const jsCommon = translations[lang].js.common;
const prefix = lang === "en" ? "/en" : "";
const href = (frSlug: string) => `${prefix}/${lang === "en" ? slugs[frSlug] : frSlug}`;
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={prefix || "/"}
  keywords={t.keywords}
>
  <section class="screen is-active">
    <header class="home-header">
      <h1 class="brand">Topla</h1>
      <p class="greeting" id="greeting">{jsCommon.greetingMorning}</p>
    </header>

    <div class="tile-grid">
      <a class="tile" href={href("lettre")} transition:name="tool-lettre" style="--tile-color:#FF6B4A">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16" /><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" /><path d="M9 20h6" /></svg>
        </span>
        <span class="tile-label">{t.tiles.lettre}</span>
      </a>

      <a class="tile" href={href("chiffre")} transition:name="tool-chiffre" style="--tile-color:#FFC542">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="9" y2="9" /><line x1="4" x2="20" y1="15" y2="15" /><line x1="10" x2="8" y1="3" y2="21" /><line x1="16" x2="14" y1="3" y2="21" /></svg>
        </span>
        <span class="tile-label">{t.tiles.chiffre}</span>
      </a>

      <a class="tile" href={href("roulette")} transition:name="tool-roulette" style="--tile-color:#1FA2A6">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8" /><path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" /><path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" /><path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" /><path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></svg>
        </span>
        <span class="tile-label">{t.tiles.roulette}</span>
      </a>

      <a class="tile" href={href("equipes")} transition:name="tool-equipes" style="--tile-color:#8B5CF6">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><path d="M16 3.128a4 4 0 0 1 0 7.744" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><circle cx="9" cy="7" r="4" /></svg>
        </span>
        <span class="tile-label">{t.tiles.equipes}</span>
      </a>

      <a class="tile" href={href("score")} transition:name="tool-score" style="--tile-color:#E85D9C">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14.66V17a1 1 0 0 1-1 1 2 2 0 0 0-2 2v2" /><path d="M14 14.66V17a1 1 0 0 0 1 1 2 2 0 0 1 2 2v2" /><path d="M17.916 10H19.5A2.5 2.5 0 0 0 22 7.5V5a1 1 0 0 0-1-1h-3" /><path d="M4 22h16" /><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z" /><path d="M6.084 10H4.5A2.5 2.5 0 0 1 2 7.5V5a1 1 0 0 1 1-1h3" /></svg>
        </span>
        <span class="tile-label">{t.tiles.score}</span>
      </a>

      <a class="tile" href={href("des")} transition:name="tool-des" style="--tile-color:#3E7BFA">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="12" height="12" x="2" y="10" rx="2" ry="2" /><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6" /><path d="M6 18h.01" /><path d="M10 14h.01" /><path d="M15 6h.01" /><path d="M18 9h.01" /></svg>
        </span>
        <span class="tile-label">{t.tiles.des}</span>
      </a>

      <a class="tile" href={href("sablier")} transition:name="tool-sablier" style="--tile-color:#FF9F43">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22h14" /><path d="M5 2h14" /><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22" /><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2" /></svg>
        </span>
        <span class="tile-label">{t.tiles.sablier}</span>
      </a>

      <a class="tile" href={href("pile-face")} transition:name="tool-pile-face" style="--tile-color:#3EAE71">
        <span class="tile-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.744 17.736a6 6 0 1 1-7.48-7.48" /><path d="M15 6h1v4" /><path d="m6.134 14.768.866-.5 2 3.464" /><circle cx="16" cy="8" r="6" /></svg>
        </span>
        <span class="tile-label">{t.tiles.pileFace}</span>
      </a>
    </div>

    <div class="home-footer">
      <button class="settings-link" id="install-app-btn" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M7 10l5 5 5-5" /><path d="M12 15V3" /></svg>
        <span>{common.installApp}</span>
      </button>
      <a class="settings-link" href={href("parametres")}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" /><circle cx="12" cy="12" r="3" /></svg>
        <span>{common.settings}</span>
      </a>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
