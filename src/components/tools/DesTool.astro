---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.des;
const common = translations[lang].common;
const prefix = lang === "en" ? "/en" : "";
const slug = lang === "en" ? slugs.des : "des";
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={`${prefix}/${slug}`}
  themeColor="#3E7BFA"
>
  <section class="screen is-active" data-accent="bleu" transition:name="tool-des">
    <header class="tool-header">
      <a class="back-btn" href={prefix || "/"} aria-label={common.back}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></a>
      <h1>{t.h1}</h1>
      <span class="header-spacer"></span>
    </header>
    <div class="tool-body">
      <div class="stepper-row">
        <span class="stepper-label">{t.countLabel}</span>
        <div class="stepper">
          <button type="button" class="stepper-btn" id="des-count-minus" aria-label={t.countMinusLabel}>−</button>
          <span class="stepper-value" id="des-count-value">1</span>
          <button type="button" class="stepper-btn" id="des-count-plus" aria-label={t.countPlusLabel}>+</button>
        </div>
      </div>

      <button class="btn btn-ghost" id="des-permission-btn" hidden>{t.permissionBtn}</button>

      <div class="des-tray" id="des-tray"></div>

      <p class="des-total" id="des-total" hidden></p>
      <p class="hint" id="des-hint">{t.hintDefault}</p>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/des.js"></script>
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
