---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.roulette;
const common = translations[lang].common;
const prefix = lang === "en" ? "/en" : "";
const slug = lang === "en" ? slugs.roulette : "roulette";
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={`${prefix}/${slug}`}
  themeColor="#1FA2A6"
>
  <section class="screen is-active" data-accent="teal" transition:name="tool-roulette">
    <header class="tool-header">
      <a class="back-btn" href={prefix || "/"} aria-label={common.back}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></a>
      <h1>{t.h1}</h1>
      <span class="header-spacer"></span>
    </header>
    <div class="tool-body roulette-body" id="roulette-zone">
      <p class="hint" id="roulette-hint">{t.hint}</p>
      <div class="countdown-display" id="roulette-countdown" hidden></div>
      <div class="roulette-surface" id="roulette-surface"></div>
    </div>
    <div class="tool-footer">
      <button class="btn btn-primary" id="roulette-start-btn">{t.startBtn}</button>
      <button class="btn btn-ghost" id="roulette-reset-btn" hidden>{t.resetBtn}</button>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/roulette.js"></script>
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
