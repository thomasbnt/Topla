---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.pileFace;
const common = translations[lang].common;
const prefix = lang === "en" ? "/en" : "";
const slug = lang === "en" ? slugs["pile-face"] : "pile-face";
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={`${prefix}/${slug}`}
  themeColor="#3EAE71"
>
  <section class="screen is-active" data-accent="vert" transition:name="tool-pile-face">
    <header class="tool-header">
      <a class="back-btn" href={prefix || "/"} aria-label={common.back}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></a>
      <h1>{t.h1}</h1>
      <span class="header-spacer"></span>
    </header>
    <div class="tool-body tap-zone" id="pile-face-tap-zone">
      <p class="hint">{t.hint}</p>
      <div class="coin">
        <div class="coin-inner" id="coin-inner">
          <div class="coin-side coin-side-pile">
            <svg class="coin-icon" viewBox="0 0 512 512" aria-hidden="true">
              <rect x="140" y="140" width="232" height="232" rx="44" transform="rotate(-8 256 256)" />
              <g>
                <circle cx="192" cy="192" r="21" transform="rotate(-8 256 256)" />
                <circle cx="320" cy="192" r="21" transform="rotate(-8 256 256)" />
                <circle cx="256" cy="256" r="21" transform="rotate(-8 256 256)" />
                <circle cx="192" cy="320" r="21" transform="rotate(-8 256 256)" />
                <circle cx="320" cy="320" r="21" transform="rotate(-8 256 256)" />
              </g>
            </svg>
            <span class="coin-label">{t.pile}</span>
          </div>
          <div class="coin-side coin-side-face">
            <svg class="coin-icon" viewBox="0 0 512 512" aria-hidden="true">
              <rect x="140" y="140" width="232" height="232" rx="44" transform="rotate(-8 256 256)" />
              <g>
                <circle cx="192" cy="192" r="21" transform="rotate(-8 256 256)" />
                <circle cx="320" cy="192" r="21" transform="rotate(-8 256 256)" />
                <circle cx="256" cy="256" r="21" transform="rotate(-8 256 256)" />
                <circle cx="192" cy="320" r="21" transform="rotate(-8 256 256)" />
                <circle cx="320" cy="320" r="21" transform="rotate(-8 256 256)" />
              </g>
            </svg>
            <span class="coin-label">{t.face}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/pile-face.js"></script>
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
