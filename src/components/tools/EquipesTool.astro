---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.equipes;
const common = translations[lang].common;
const prefix = lang === "en" ? "/en" : "";
const slug = slugs.equipes;
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={`${prefix}/${slug}`}
  themeColor="#8B5CF6"
>
  <section class="screen is-active" data-accent="violet" transition:name="tool-equipes">
    <header class="tool-header">
      <a class="back-btn" href={prefix || "/"} aria-label={common.back}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></a>
      <h1>{t.h1}</h1>
      <span class="header-spacer"></span>
    </header>
    <div class="tool-body">
      <div class="equipes-normal-view" id="equipes-normal-view">
        <form class="add-form" id="equipes-add-form">
          <input type="text" id="equipes-name-input" placeholder={t.namePlaceholder} aria-label={t.namePlaceholder} autocomplete="off" maxlength="24" />
          <button type="submit" class="btn btn-accent" aria-label={t.addLabel}>+</button>
        </form>

        <button type="button" class="btn btn-ghost" id="equipes-finger-btn">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8" /><path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" /><path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" /><path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" /><path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></svg>
          {t.fingerBtn}
        </button>

        <div class="chip-list" id="equipes-chip-list"></div>
        <button type="button" class="chip-clear-btn" id="equipes-clear-btn" hidden>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
          {t.clearListBtn}
        </button>

        <div class="stepper-row">
          <span class="stepper-label">{t.teamsCountLabel}</span>
          <div class="stepper">
            <button type="button" class="stepper-btn" id="equipes-count-minus" aria-label={t.teamsMinusLabel}>−</button>
            <span class="stepper-value" id="equipes-count-value">2</span>
            <button type="button" class="stepper-btn" id="equipes-count-plus" aria-label={t.teamsPlusLabel}>+</button>
          </div>
        </div>

        <button class="btn btn-primary" id="equipes-generate-btn">{t.generateBtn}</button>
        <p class="error-msg" id="equipes-error" hidden></p>

        <div class="teams-result" id="equipes-result"></div>
      </div>

      <div class="finger-detect" id="equipes-finger-detect" hidden>
        <p class="hint" id="equipes-finger-hint">{t.fingerHintDefault}</p>
        <div class="countdown-display" id="equipes-finger-countdown" hidden></div>
        <div class="finger-detect-surface" id="equipes-finger-surface"></div>
        <div class="finger-detect-footer">
          <span class="finger-detect-count" id="equipes-finger-count">{t.fingerCountDefault}</span>
          <div class="finger-detect-actions">
            <button type="button" class="btn btn-primary" id="equipes-finger-confirm">{t.fingerConfirmDefault}</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/modal.js"></script>
    <script is:inline src="/js/equipes.js"></script>
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
