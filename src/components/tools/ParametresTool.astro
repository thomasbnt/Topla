---
import Layout from "../../layouts/Layout.astro";
import { translations, slugs } from "../../i18n/translations.js";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = translations[lang].pages.parametres;
const common = translations[lang].common;
const jsParametres = translations[lang].js.parametres;
const prefix = lang === "en" ? "/en" : "";
const slug = slugs.parametres;
---

<Layout
  lang={lang}
  title={t.title}
  description={t.description}
  canonicalPath={`${prefix}/${slug}`}
  noindex
>
  <section class="screen is-active">
    <header class="tool-header">
      <a class="back-btn" href={prefix || "/"} aria-label={common.back}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></a>
      <h1>{t.h1}</h1>
      <span class="header-spacer"></span>
    </header>
    <div class="tool-body">
      <div class="stepper-row">
        <span class="stepper-label">{t.languageLabel}</span>
        <div class="stepper lang-switch">
          <a class={`stepper-btn lang-btn${lang === "fr" ? " is-selected" : ""}`} href={`/${slugs.parametres}`}>FR</a>
          <a class={`stepper-btn lang-btn${lang === "en" ? " is-selected" : ""}`} href={`/en/${slugs.parametres}`}>EN</a>
        </div>
      </div>

      <a class="storage-card github-card" href="https://github.com/thomasbnt/Topla" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="storage-icon"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 1.5 5 1.5 5 1.5c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 8.5c0 3.5 3 5.5 6 5.5a4.8 4.8 0 0 0-1 3.5v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        <div>
          <p class="storage-label">{t.githubLabel}</p>
          <p class="storage-value">{t.githubValue}</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="github-card-chevron"><path d="m9 18 6-6-6-6" /></svg>
      </a>

      <a class="storage-card github-card" href="https://astro.build" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="storage-icon"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" /><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" /><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" /><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" /></svg>
        <div>
          <p class="storage-label">{t.astroLabel}</p>
          <p class="storage-value">astro.build</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="github-card-chevron"><path d="m9 18 6-6-6-6" /></svg>
      </a>

      <a class="storage-card github-card" id="commit-info-link" href="https://github.com/thomasbnt/Topla/commits/main" target="_blank" rel="noopener noreferrer" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="storage-icon"><circle cx="12" cy="12" r="3" /><line x1="3" y1="12" x2="9" y2="12" /><line x1="15" y1="12" x2="21" y2="12" /></svg>
        <div>
          <p class="storage-label">{t.commitLabel}</p>
          <p class="storage-value" id="commit-info-value">—</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="github-card-chevron"><path d="m9 18 6-6-6-6" /></svg>
      </a>

      <button class="btn btn-ghost" id="update-app-btn" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg>
        {jsParametres.updateDefault}
      </button>

      <div class="storage-card">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="storage-icon"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5V19A9 3 0 0 0 21 19V5" /><path d="M3 12A9 3 0 0 0 21 12" /></svg>
        <div>
          <p class="storage-label">{t.storageLabel}</p>
          <p class="storage-value" id="storage-value">0 o</p>
        </div>
      </div>

      <p class="hint hint-small">{t.storageHint}</p>

      <button class="btn btn-ghost" id="cache-clear-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg>
        {t.cacheBtn}
      </button>

      <button class="btn btn-danger-outline" id="storage-clear-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
        {t.deleteBtn}
      </button>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/js/modal.js"></script>
    <script is:inline src="/js/commit-info.js"></script>
    <script is:inline src="/js/parametres.js"></script>
    <script is:inline src="/js/app.js"></script>
  </Fragment>
</Layout>
